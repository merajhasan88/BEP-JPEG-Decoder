# Build outputs: regenerated by the tools, not part of the sources.  Files generated by Quartus
# (databases, reports, netlists, timing and programming files) also carry the tool vendor's terms.

# Verilator builds and simulation outputs
tb/obj_*/
tb/obj_*.log
tb/build/
tb/out/
tb/build_*.log
boards/*/sim/obj_*/
boards/*/sim/obj_*.log
boards/ep2c5/gate_level/verilator/obj_*/
boards/ep2c5/gate_level/verilator/*.vo
boards/ep2c5/gate_level/verilator/*.ppm
boards/ep2c5/gate_level/verilator/verilate_*.log
boards/ep2c5/gate_level/icarus/db/
boards/ep2c5/gate_level/icarus/*.bin
boards/ep2c5/gate_level/icarus/*.ppm
boards/ep2c5/gate_level/icarus/*.log

# Quartus projects (boards/ep2c5/*, quartus/*) and Vivado builds (boards/*/build)
db/
incremental_db/
simulation/
output_files/
*.qws
*.rpt
*.summary
*.smsg
*.done
*.jdi
*.pin
*.sof
*.pof
*.qarlog
sta_paths.txt
compile_log.txt
pow_log.txt
qsf.bak
boards/*/build/
greybox_tmp/
.Xil/

# Python
__pycache__/
*.pyc

# Comparison decoders (bench/others): fetched sources live outside, their builds are outputs
bench/others/obj_*/
bench/others/quartus/cmp*/

# Tool logs (outputs of builds and runs; the *.txt result files cited by the docs are kept)
*.log

# Images: decoded outputs, golden decodes and simulation outputs are generated, not kept.  The
# JPEGs that are kept: test_images/ (the owner's photos), tb/corpus/ (made from
# test_images/adapter.jpg by scripts/make_corpus.py, see tb/corpus/SOURCES.md) and tb/malformed/
# (tb/make_malformed.py), tb/arith/ (tb/make_arith.py: synthetic files at the arithmetic limits) and
# tb/golden/ (the reference images of the regression, made by model/jpeg_golden.py through
# tb/run_tests.py; tb/run_tests.sh compares against them).
*.jpg
*.jpeg
*.png
*.ppm
*.pnm
*.pgm
*.bmp
!test_images/*.jpg
!tb/corpus/*.jpg
!tb/malformed/*.jpg
!tb/arith/*.jpg
!tb/golden/*.pnm
tb/golden_legacy/

# Local only, never published: the review of the owner's original 2022-23 code
REVIEW.md

# Remote board runs: raw results (the consolidated results_<date>.json files are kept)
boards/*/results_pi*.json

# scripts/decode.py output
out/

# bench: fetched comparison decoders and downloaded/built reference tools
bench/others/third_party/
bench/build/


# performance model: blockstats binary, per-block statistics, 4:2:0 copies, sweep results
model/perf/build/
